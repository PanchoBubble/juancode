{
  "id": "queue",
  "title": "queue snapshots",
  "asserts": "the queue is pushed as a complete ordered list on subscribe and after every change, is replaced wholesale rather than patched, and stops being pushed after unsubscribe.",
  "requires": [
    "pty"
  ],
  "capabilities": [
    "queue"
  ],
  "ignore": [
    "activity",
    "output",
    "sessionMeta",
    "gridChange"
  ],
  "steps": [
    {
      "send": {
        "type": "create",
        "provider": "claude",
        "cwd": "$cwd",
        "cols": 80,
        "rows": 24
      }
    },
    {
      "expect": {
        "type": "created"
      },
      "bind": {
        "session": "session.id"
      },
      "timeoutMs": 20000
    },
    {
      "expect": {
        "type": "attached",
        "sessionId": "$session"
      }
    },
    {
      "send": {
        "type": "input",
        "sessionId": "$session",
        "data": "BUSY\r"
      },
      "note": "hold the session busy so nothing is delivered out from under the snapshots"
    },
    {
      "expect": {
        "type": "activity",
        "sessionId": "$session",
        "state": "busy"
      },
      "timeoutMs": 20000,
      "note": "the premise, waited for rather than slept through: until the core has SEEN the turn start, the delivery pump reads the session as idle and is free to claim the head of the queue"
    },
    {
      "send": {
        "type": "subscribeQueue",
        "sessionId": "$session"
      }
    },
    {
      "expect": {
        "type": "queue",
        "sessionId": "$session",
        "items": []
      }
    },
    {
      "send": {
        "type": "queueMessage",
        "sessionId": "$session",
        "text": "first"
      }
    },
    {
      "expect": {
        "type": "queue",
        "sessionId": "$session",
        "items": [
          {
            "id": {
              "$type": "string"
            },
            "text": "first",
            "createdAt": {
              "$type": "number"
            }
          }
        ]
      },
      "bind": {
        "firstId": "items.0.id"
      }
    },
    {
      "send": {
        "type": "input",
        "sessionId": "$session",
        "data": "BUSY\r"
      }
    },
    {
      "send": {
        "type": "queueMessage",
        "sessionId": "$session",
        "text": "second"
      }
    },
    {
      "expect": {
        "type": "queue",
        "sessionId": "$session",
        "items": [
          {
            "text": "first"
          },
          {
            "text": "second"
          }
        ]
      },
      "note": "insertion order is delivery order"
    },
    {
      "send": {
        "type": "input",
        "sessionId": "$session",
        "data": "BUSY\r"
      }
    },
    {
      "send": {
        "type": "queueMessage",
        "sessionId": "$session",
        "text": "   "
      }
    },
    {
      "expectNone": {
        "type": "queue",
        "sessionId": "$session",
        "items": {
          "$some": {
            "text": {
              "$regex": "^\\s*$"
            }
          }
        }
      },
      "withinMs": 600,
      "note": "a whitespace-only message is not queued at all, so no snapshot may ever carry an item whose text is blank - trimmed to empty counts. Asserted about content and not about silence, exactly as the refused edit in queue-edit is: the delivery pump owns the pending -> inFlight edge and may broadcast a snapshot inside this window, and a step that forbade any queue frame here would be asserting a property the protocol does not have"
    },
    {
      "send": {
        "type": "dequeueMessage",
        "sessionId": "$session",
        "messageId": "$firstId"
      }
    },
    {
      "expect": {
        "type": "queue",
        "sessionId": "$session",
        "items": [
          {
            "text": "second"
          }
        ]
      }
    },
    {
      "send": {
        "type": "unsubscribeQueue",
        "sessionId": "$session"
      }
    },
    {
      "sleep": 200
    },
    {
      "send": {
        "type": "queueMessage",
        "sessionId": "$session",
        "text": "third"
      }
    },
    {
      "expectNone": {
        "type": "queue"
      },
      "withinMs": 800
    }
  ]
}
