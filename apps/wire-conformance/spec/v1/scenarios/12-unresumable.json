{
  "id": "unresumable",
  "title": "unresumable reactivate",
  "asserts": "reactivating a dead session whose CLI conversation id was never captured is answered with `unresumable` and a human-readable reason, not an error and not a silent nothing.",
  "requires": ["pty"],
  "ignore": ["activity", "output"],
  "steps": [
    {
      "send": {
        "type": "create",
        "provider": "codex",
        "cwd": "$cwd",
        "cols": 80,
        "rows": 24
      },
      "note": "codex has no flag to pin a session id, so it stays unknown until discovered"
    },
    {
      "expect": {
        "type": "created",
        "session": {
          "provider": "codex",
          "cliSessionId": {
            "$absent": true
          }
        }
      },
      "bind": {
        "session": "session.id"
      },
      "timeoutMs": 20000
    },
    {
      "expect": {
        "type": "attached",
        "sessionId": "$session"
      }
    },
    {
      "send": {
        "type": "input",
        "sessionId": "$session",
        "data": "EXIT 0\r"
      }
    },
    {
      "expect": {
        "type": "exit",
        "sessionId": "$session",
        "exitCode": 0
      },
      "timeoutMs": 15000
    },
    {
      "send": {
        "type": "reactivate",
        "sessionId": "$session",
        "cols": 80,
        "rows": 24
      }
    },
    {
      "expect": {
        "type": "unresumable",
        "sessionId": "$session",
        "reason": {
          "$contains": "No prior CLI conversation"
        }
      },
      "timeoutMs": 15000
    }
  ]
}
