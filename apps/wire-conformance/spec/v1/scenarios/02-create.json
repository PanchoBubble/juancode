{
  "id": "create",
  "title": "create replies created then attached",
  "asserts": "a create spawns a session, the client learns its identity from `created`, and the immediately following `attached` has empty scrollback because there is nothing to replay yet.",
  "requires": [
    "pty"
  ],
  "ignore": [
    "activity",
    "output",
    "sessionMeta",
    "gridChange"
  ],
  "steps": [
    {
      "send": {
        "type": "create",
        "provider": "claude",
        "cwd": "$cwd",
        "cols": 80,
        "rows": 24
      }
    },
    {
      "expect": {
        "type": "created",
        "session": {
          "id": {
            "$type": "string"
          },
          "provider": "claude",
          "cwd": "$cwd",
          "title": {
            "$type": "string"
          },
          "status": "running",
          "kind": "agent",
          "skipPermissions": false,
          "createdAt": {
            "$type": "number"
          },
          "updatedAt": {
            "$type": "number"
          },
          "cliSessionId": {
            "$type": "string"
          }
        }
      },
      "bind": {
        "session": "session.id"
      },
      "timeoutMs": 20000,
      "note": "claude pins its CLI session id at spawn, so it is known immediately"
    },
    {
      "expect": {
        "type": "attached",
        "sessionId": "$session",
        "scrollback": "",
        "session": {
          "id": "$session",
          "status": "running"
        }
      }
    },
    {
      "expect": {
        "type": "output",
        "sessionId": "$session",
        "data": {
          "$contains": "fake-agent ready"
        }
      },
      "timeoutMs": 15000,
      "note": "the pty's own bytes stream to an attached connection"
    }
  ]
}
