{
  "id": "handshake",
  "title": "Capability handshake",
  "asserts": "serverInfo is frame 0 on every connection, carrying the protocol version and an honest capability list, so feature detection happens before the client interprets any other frame, including the activity broadcasts for sessions that were already live.",
  "requires": ["pty"],
  "ignore": ["activity", "output"],
  "steps": [
    {
      "expectHandshake": {
        "type": "serverInfo",
        "protocolVersion": 1,
        "capabilities": {
          "$type": "array"
        }
      }
    },
    {
      "expectHandshake": {
        "capabilities": {
          "$contains": "inputAck"
        }
      }
    },
    {
      "expectHandshake": {
        "capabilities": {
          "$contains": "resizeAck"
        }
      }
    },
    {
      "expectHandshake": {
        "capabilities": {
          "$contains": "screen"
        }
      }
    },
    {
      "expectFirstFrame": {
        "type": "serverInfo"
      },
      "note": "nothing precedes the handshake on a fresh connection"
    },
    {
      "send": {
        "type": "create",
        "provider": "claude",
        "cwd": "$cwd",
        "cols": 80,
        "rows": 24
      },
      "note": "a live session is what used to push the handshake off frame 0"
    },
    {
      "expect": {
        "type": "created",
        "session": {
          "id": {
            "$type": "string"
          }
        }
      },
      "bind": {
        "session": "session.id"
      },
      "timeoutMs": 20000
    },
    {
      "open": "b"
    },
    {
      "expectFirstFrame": {
        "type": "serverInfo",
        "protocolVersion": 1,
        "capabilities": {
          "$type": "array"
        }
      },
      "on": "b",
      "note": "the session's activity broadcast follows the handshake, never precedes it"
    }
  ]
}
